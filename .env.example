# Copie este arquivo para `.env` na raiz do repositório e preencha os valores.
# Nunca commitar `.env` (já está no .gitignore).

# --- Obrigatório para o agente analista (OpenAI) ---
OPENAI_API_KEY=

# Modelo OpenAI (opcional; padrão abaixo)
# OPENAI_MODEL=gpt-4.1-mini

# --- Agente ---
# false desativa o endpoint /api/agent/query e retorna 503 se alguém chamar
# AGENT_ENABLED=true

# AGENT_MAX_CONTEXT_TOKENS=18000
# AGENT_MAX_OUTPUT_TOKENS=900
# AGENT_TIMEOUT_SECONDS=20

# --- API (CORS) ---
# Origens permitidas, separadas por vírgula (padrão: Vite em 5173)
# CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend (opcional) ---
# Crie `frontend/.env` ou `frontend/.env.local` se quiser controlar a aba do agente na UI:
# VITE_AGENT_ENABLED=true
